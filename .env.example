# BrajSahayak Environment Configuration
PORT=5001
NODE_ENV=development

# Database
# For Local SQLite (Default zero-config):
DATABASE_URL="file:./dev.db"
# For PostgreSQL / AWS RDS:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/brajsahayak?schema=public"

# AI Provider ("grounded-knowledge-engine" is self-contained and does NOT require Amazon Bedrock)
AI_PROVIDER=grounded-knowledge-engine

# Storage Provider ("local" for local disk, "s3" for Amazon S3)
STORAGE_PROVIDER=local
S3_BUCKET_NAME=brajsahayak-assets
AWS_REGION=ap-south-1

# Security
AUTHORITY_ADMIN_KEY="braj-authority-secure-key"
CORS_ORIGIN="http://localhost:5173"
